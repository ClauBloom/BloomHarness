<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.claubloom.harness</groupId>
        <artifactId>bloom-harness-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bloom-harness-skills</artifactId>
    <name>BloomHarness Skills</name>
    <description>Skill Resource Discovery and Prompt Injection Engine built on Spring AI</description>

    <dependencies>
        <dependency>
            <groupId>com.claubloom.harness</groupId>
            <artifactId>bloom-harness-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.claubloom.harness</groupId>
            <artifactId>bloom-harness-core</artifactId>
        </dependency>

        <!-- Spring AI Core for Resource, PromptTemplate, and Advisor abstraction -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-core</artifactId>
        </dependency>

        <!-- SnakeYAML for frontmatter parsing -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
