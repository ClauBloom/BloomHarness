<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.claubloom.harness</groupId>
        <artifactId>bloom-harness-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>bloom-harness-ai-adapter</artifactId>
    <name>BloomHarness AI Adapter</name>
    <description>AI Model Adapter integrating ai-router-core for multi-provider routing and protocol translation</description>

    <dependencies>
        <dependency>
            <groupId>com.claubloom.harness</groupId>
            <artifactId>bloom-harness-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>com.claubloom.harness</groupId>
            <artifactId>bloom-harness-core</artifactId>
        </dependency>

        <!-- MiniAPIRouter Core SDK -->
        <dependency>
            <groupId>com.miniapi</groupId>
            <artifactId>ai-router-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
